#!/bin/sh
# ANEW residue helper — splits survivors into the ones check could have started and the ones it
# could not (docs/testing.md, Resource hygiene). Used by scripts/residue; a separate file so the
# selftest can feed it synthetic process tables — the classification is the part that can be
# subtly wrong, and a green run on a real machine does not prove it right.
#
#   scripts/lib/classify-survivors <posix|windows> <process-table> < survivors
#
# Both the table and the survivors are TAB-separated "pid<TAB>ppid<TAB>command" lines; the table
# is every live process, the survivors are the subset being judged. One line per survivor comes
# out: "counted<TAB>pid<TAB>command" or "ignored<TAB>reason<TAB>pid<TAB>command".
# A survivor line whose pid is not a number is not a process: the caller's measurement lost a line
# break. It is refused (exit 2), never guessed at — counting it would name a text fragment as
# residue, and ignoring it would hide a real one.
#
# A survivor is ignored only when its ancestry reaches a root check cannot start under:
#   posix    pid 2 (kthreadd) — kernel threads. NEVER pid 1: an orphaned process of check's own
#            is reparented to init, and ignoring that would hide the very thing this test exists
#            for.
#   windows  services.exe (the service control manager) or pid 4 (System).
# Anything whose ancestry cannot be walked is counted, not ignored: a tool that silently drops
# what it cannot explain is the failure this helper was written to remove.
set -u
case "$#:${1:-}" in
  2:posix|2:windows) os=$1; table=$2 ;;
  *) echo "usage: scripts/lib/classify-survivors <posix|windows> <process-table>" >&2; exit 2 ;;
esac
[ -r "$table" ] || { echo "classify-survivors: cannot read process table: $table" >&2; exit 2; }
# An empty table is refused as well: awk's two-file idiom cannot tell an empty first file from the
# second one, so every survivor would be read as a table row and vanish without a word.
[ -s "$table" ] || { echo "classify-survivors: empty process table: $table" >&2; exit 2; }

awk -F'\t' -v os="$os" '
  # The executable part of a Windows command line, lowercased and without its directory.
  function image(c,   s) {
    s = tolower(c)
    sub(/^"[^"]*"/, "&", s)                     # a quoted path keeps its spaces
    gsub(/"/, "", s)
    sub(/[ \t].*$/, "", s)                      # drop the arguments
    sub(/^.*[\\\/]/, "", s)                     # drop the directory
    return s
  }
  NR == FNR { if ($1 ~ /^[0-9]+$/) { ppid[$1] = $2; cmd[$1] = $3 }; next }
  $1 !~ /^[0-9]+$/ {                            # not a process: the caller lost a line break
    print "classify-survivors: malformed survivor line (pid is not a number): " $0 > "/dev/stderr"
    bad = 1; next
  }
  {
    reason = ""; q = $1
    for (i = 0; i < 64; i++) {
      if (!(q in ppid)) break                   # ancestry lost — fail closed, count it
      if (os == "posix") {
        if (q == "2") { reason = "kernel thread"; break }
        if (q == "1" || q == "0") break         # init: check own orphans land here too
      } else {
        if (image(cmd[q]) == "services.exe") { reason = "OS service"; break }
        if (q == "4" || q == "0") { reason = "system process"; break }
      }
      if (ppid[q] == q) break                   # a process that is its own parent
      q = ppid[q]
    }
    if (reason == "") print "counted\t" $1 "\t" $3
    else print "ignored\t" reason "\t" $1 "\t" $3
  }
  END { if (bad) exit 2 }
' "$table" -
